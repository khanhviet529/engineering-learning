# Biến mà API cần từ NỀN TẢNG khi chạy production.
#
# File này CHỈ chứa TÊN. Không giá trị, không ví dụ, không placeholder — kể cả
# giá trị giả. Một template có chỗ điền là một template người ta điền, và file
# đã điền nằm cạnh code là đúng thứ chính sách secret cấm.
#
# File này KHÔNG được nạp bởi bất cứ thứ gì. `apps/api` script `start` là
# `node dist/main.js` và không đọc file nào — `scripts/check-config-boundary.mjs`
# cưỡng chế điều đó ở mỗi lượt `pnpm lint`. Production đọc biến từ environment
# do nền tảng inject (secret manager của platform, không phải file trên đĩa).
#
# Danh sách này được `apps/api/src/test/env-template.test.ts` so **chính xác**
# với `envSchema`. Thêm hay bỏ một biến trong schema mà quên file này thì test
# đỏ — đó là lý do file tồn tại thay vì một mục trong tài liệu.
#
# Thiếu một biến bắt buộc thì API dừng lúc khởi động và in ra **tên** của mọi
# biến thiếu cùng lúc, không phải từng cái một. Xem `shared/config/env.ts`.

# --- Bắt buộc ---------------------------------------------------------------
# Không có giá trị mặc định. Thiếu một trong số này là API không khởi động.

# Origin công khai của web. Dùng cho CORS allowlist và cho link trong email.
WEB_ORIGIN=
# Chuỗi kết nối PostgreSQL. API là consumer duy nhất của credential này.
DATABASE_URL=
# Ký cursor phân trang (KHÔNG ký session). Tối thiểu 32 ký tự.
CURSOR_SECRET=
# Ký CSRF token. Tối thiểu 32 ký tự. Xoay nó làm mọi tab đang mở nhận 403.
CSRF_SECRET=
# SMTP đích. Ở production là provider thật, không phải Mailpit.
SMTP_HOST=
SMTP_PORT=

# --- Tuỳ chọn ---------------------------------------------------------------
# Bỏ trống hoặc không đặt thì API dùng mặc định. Chuỗi rỗng = chưa đặt.

# Mặc định `development`. Đặt `production` ở môi trường thật.
NODE_ENV=
# Mặc định 3001.
API_PORT=
# Mặc định `info`.
LOG_LEVEL=
# Credential SMTP. Đặt CẢ HAI hoặc KHÔNG CÁI NÀO — một nửa cặp là lỗi cấu hình
# lúc khởi động. Có credential thì transport bật TLS.
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ From. Mặc định trỏ tên miền `.test`, mà provider thật sẽ từ chối —
# đặt sang tên miền đã xác minh SPF/DKIM/DMARC trước khi cắm provider.
MAIL_FROM=
# Cửa sổ xoay key: đặt giá trị CŨ vào đây khi vừa đổi giá trị hiện hành. Xoá
# biến để đóng cửa sổ; không có gì đóng hộ.
CURSOR_SECRET_PREVIOUS=
CSRF_SECRET_PREVIOUS=
# Nới rate limit cho một số route đã đặt tên, dạng JSON. Để trống ở production:
# thiếu biến nghĩa là dùng bảng giới hạn production.
RATE_LIMIT_OVERRIDES=
