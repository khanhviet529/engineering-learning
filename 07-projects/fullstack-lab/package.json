{
  "name": "flowboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flowboard — workspace quản lý công việc riêng tư theo project, dựng như lab kỹ thuật",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "tokens": "node scripts/generate-tokens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flowboard/config": "workspace:*",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
