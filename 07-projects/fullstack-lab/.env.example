# Template environment của Flowboard — CHỈ chứa tên biến, mô tả, và ví dụ
# KHÔNG phải secret. Copy sang `.env` rồi tự tạo giá trị local.
#
# Quy tắc ở docs/operations/local-development.md: giá trị thật không bao giờ
# được commit, copy vào ticket/chat, hay dùng lại secret của production.

# --- Cổng publish ra host ---------------------------------------------------
# Cố ý **không** dùng cổng mặc định của từng service. Nếu máy bạn đã có một
# PostgreSQL khác nghe 5432 thì công cụ chạy từ host sẽ nối nhầm database, và
# triệu chứng duy nhất bạn thấy là "password authentication failed" — rất tốn thời
# gian để tìm ra. Trong mạng Compose, các service vẫn gọi nhau bằng cổng gốc.
POSTGRES_HOST_PORT=5433
MAILPIT_SMTP_HOST_PORT=1026
MAILPIT_UI_HOST_PORT=8026
API_HOST_PORT=3001
WEB_HOST_PORT=3000

# --- Non-secret config ------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Rate limit ---------------------------------------------------------------
# Nới giới hạn cho **một số route đã đặt tên**, dạng JSON. Bỏ trống ở mọi môi
# trường thật: thiếu biến nghĩa là API dùng bảng giới hạn production.
#
# Chỉ đặt ở máy chạy E2E, nơi dữ liệu được tạo qua chính sản phẩm từ một IP:
#   RATE_LIMIT_OVERRIDES={"auth.sign-up":{"limit":1000,"windowMs":60000},"auth.sign-in":{"limit":1000,"windowMs":60000},"workspace.invite":{"limit":1000,"windowMs":60000}}
#
# Tên route sai hoặc giá trị vô lý làm API **dừng lúc khởi động**, không phải bị
# bỏ qua im lặng.
RATE_LIMIT_OVERRIDES=

# --- Kết nối PostgreSQL -----------------------------------------------------
# API là consumer duy nhất của credential này.
POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
# Secret local: tự tạo, đừng dùng giá trị mẫu này ngoài máy của bạn.
POSTGRES_PASSWORD=doi-gia-tri-nay
# API chạy trong mạng Compose nên dùng tên service.
DATABASE_URL=postgres://flowboard:doi-gia-tri-nay@postgres:5432/flowboard
# Công cụ chạy từ host (drizzle-kit, psql) dùng cổng đã publish.
DATABASE_URL_HOST=postgres://flowboard:doi-gia-tri-nay@localhost:5433/flowboard

# --- Vật liệu ký session và CSRF -------------------------------------------
# Tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-tu-32-ky-tu-tro-len
CSRF_SECRET=thay-bang-mot-chuoi-ngau-nhien-khac-32-ky-tu

# --- Mailpit ----------------------------------------------------------------
# Chỉ bắt mail ở local; không relay ra Internet, không phải service production.
SMTP_HOST=mailpit
SMTP_PORT=1025
