{
  "name": "@flowboard/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Hợp đồng transport dùng chung giữa apps/web và apps/api: Zod schema, type suy ra, error-code vocabulary. Không phụ thuộc Drizzle, NestJS, Next.js hay React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@flowboard/config": "workspace:*",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
