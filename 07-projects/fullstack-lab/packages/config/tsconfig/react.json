{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Flowboard react app",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
