{
  "name": "@flowboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP boundary và product behavior phía server: NestJS trên Fastify, PostgreSQL qua Drizzle.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@flowboard/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@flowboard/config": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.11"
  }
}
